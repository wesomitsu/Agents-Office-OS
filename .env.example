# Copy this file to .env and fill in what you use. .env is git-ignored,
# so your keys stay on your machine. Leave a line empty to skip that provider.

# Anthropic (Claude) - https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Any OpenAI-compatible API. Set the base URL for OpenRouter, Groq, Together,
# a local Ollama (http://localhost:11434/v1, no key needed), and so on.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional: who the agents work for (added to every agent's instructions)
COMPANY_NAME=
COMPANY_ABOUT=

# Optional: require a password (browser login, any username) - set this
# before making the office reachable from other machines
OFFICE_PASSWORD=

# Optional: server settings
PORT=3000
# HOST=127.0.0.1
